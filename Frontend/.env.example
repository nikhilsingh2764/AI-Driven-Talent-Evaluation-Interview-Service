# Where the browser sends API calls.
# Default "/api/v1" works with the Vite dev proxy, the Vercel rewrite in vercel.json and the Docker/nginx setup.
# Set a full URL (https://api.example.com/api/v1) only if the API is on ANOTHER domain - then the backend needs
# COOKIE_SAMESITE=none and HTTPS, and some browsers (Safari, Brave) will still block the login cookie.
VITE_API_URL=/api/v1

# Dev server only: where /api and /health are proxied to.
VITE_PROXY_TARGET=http://localhost:5000
