# Used by docker-compose.yml (copy to .env). For npm development use Backend/.env and Frontend/.env instead.
PUBLIC_URL=http://localhost:8080

# Required. Generate each:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=

# "production" has no mock AI: without OPENROUTER_API_KEY the AI endpoints answer 503.
# For a first try without any key set  NODE_ENV=development  and  AI_MOCK=true.
NODE_ENV=production
AI_MOCK=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=inclusionai/ling-3.0-flash:free

# Optional
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
BREVO_API_KEY=
EMAIL_FROM=
# Development only: show OTP codes on the signup page when no email is configured
EXPOSE_OTP_IN_RESPONSE=false
