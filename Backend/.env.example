# ═════════ Required ═════════
MONGODB_URI=mongodb://127.0.0.1:27017/ai-interview
# Two DIFFERENT long random strings. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ACCESS_TOKEN_SECRET=change-me-access-secret
REFRESH_TOKEN_SECRET=change-me-refresh-secret

# ═════════ Server ═════════
PORT=5000
NODE_ENV=development
# Frontend origin(s) allowed by CORS, comma separated, no trailing slash
CLIENT_URL=http://localhost:5173
# Token lifetimes. Format: 30s | 15m | 2h | 15d. Cookies and the database follow these values.
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=15d
# Cookie SameSite: lax (default; same-site / dev proxy / Vercel rewrite), strict, or none (HTTPS; frontend on another site)
COOKIE_SAMESITE=lax
# Number of reverse proxies in front of the app (Render alone = 1; Vercel rewrite + Render = 2)
TRUST_PROXY=1
# Swagger UI at /api/docs (set false to hide it)
SWAGGER_ENABLED=true

# ═════════ Optional - everything below has a working local fallback ═════════

# Redis for cache + rate limits. Empty = in-memory (fine for one server).
REDIS_URL=

# AI via OpenRouter. With no key (and NODE_ENV not production) a built-in MOCK AI is used,
# so every endpoint works for free while you develop.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=inclusionai/ling-3.0-flash:free
# Any OpenAI-compatible endpoint works: OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Force the mock AI even if a key exists: AI_MOCK=true
AI_MOCK=

# Resume storage. Empty = PDFs saved on local disk in Backend/uploads (lost on Render redeploys).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email option A (recommended, also works on Render's free plan which blocks SMTP): Brevo HTTPS API.
#   BREVO_API_KEY = Brevo -> SMTP & API -> API Keys.   EMAIL_FROM = a sender verified in Brevo.
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=AI Interview Service
# Email option B: classic SMTP (blocked on Render free). With nothing configured, codes are printed in the server log.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=

# Development only (ignored when NODE_ENV=production):
# put the OTP in the signup / forgot-password / resend-otp response so you can test without email
EXPOSE_OTP_IN_RESPONSE=true
# turn rate limiting off (the e2e test needs this)
RATE_LIMIT_DISABLED=false
