# ===== Required =====
MONGODB_URI=mongodb://127.0.0.1:27017/ai-interview
# Two DIFFERENT long random strings. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ACCESS_TOKEN_SECRET=change-me-access-secret
REFRESH_TOKEN_SECRET=change-me-refresh-secret

# ===== Server =====
PORT=5000
NODE_ENV=development
# Frontend origin(s) allowed by CORS, comma separated
CLIENT_URL=http://localhost:5173
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=15d
# Cookie SameSite: lax (default), strict, or none (needs HTTPS, for a frontend on another site)
COOKIE_SAMESITE=lax

# ===== Optional: everything below has a working fallback for local testing =====

# Redis for cache + rate limits. Leave empty to use in-memory.
REDIS_URL=

# AI via OpenRouter. With no key (and NODE_ENV not production) a built-in MOCK AI is used so every endpoint still works.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=inclusionai/ling-3.0-flash:free
# Any OpenAI-compatible endpoint works. Default is OpenRouter.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Force mock AI even if a key exists: AI_MOCK=true
AI_MOCK=

# Resume storage. Leave empty to save PDFs on disk in Backend/uploads/resumes.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email option A (recommended for Render free plan, which BLOCKS SMTP): Brevo HTTPS API.
# Create a free Brevo account, verify a sender email, create an API key.
BREVO_API_KEY=
EMAIL_FROM=
# Email option B: classic SMTP (does not work on Render's free plan). Leave everything empty and OTP emails are printed in the server console instead.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM_NAME=AI Interview Service

# Number of reverse proxies in front of the app. Render alone = 1 (default). Vercel rewrite + Render = 2.
TRUST_PROXY=1

# Dev only: include the OTP in the signup / forgot-password API response (ignored when NODE_ENV=production)
EXPOSE_OTP_IN_RESPONSE=true
# Dev only: turn rate limiting off (needed by `npm run e2e`). Set to false (or remove) in production.
RATE_LIMIT_DISABLED=true
